# === DB ===
DATABASE_URL=            # Neon/Supabase PostgreSQL connection string

# === Security ===
ENCRYPTION_KEY=          # 32 bayt (hex yoki base64) — AES-256-GCM uchun; worker'da GitHub secret
ADMIN_PASSWORD=          # Admin panelga kirish paroli (TZ 4.8)
AUTH_SECRET=             # Sessiya shifrlash uchun

# === Vercel ===
CRON_SECRET=             # Vercel Cron -> /api/cron/* himoyasi
BLOB_READ_WRITE_TOKEN=   # Vercel Blob

# === AI (admin paneldan ham kiritiladi; bu — dev uchun) ===
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# === Meta / Instagram ===
META_APP_ID=
META_APP_SECRET=

# === Bildirishnomalar ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# === Stock ===
PEXELS_API_KEY=
