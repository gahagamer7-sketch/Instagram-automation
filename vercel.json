{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm turbo build --filter=web...",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/cron/produce",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "0 14 * * *"
    }
  ]
}

